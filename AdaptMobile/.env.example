# ===============================================
# ADAPTMOBILE ENVIRONMENT CONFIGURATION
# ===============================================

# PostgreSQL Database
POSTGRES_DB=adaptmobile
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_PORT=5432

# Backend JWT Secrets
SECRET_KEY=adaptmobile_super_secret_jwt_key_2025_prod
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials
ADMIN_EMAIL=admin@adaptmobile.io
ADMIN_PASSWORD=admin123

# AI Microservice Engine
# Options: 'heuristic' (zero API keys required, works 100% out-of-the-box offline), 'gemini', or 'openai'
AI_PROVIDER=heuristic
OPENAI_API_KEY=
GEMINI_API_KEY=
AI_MODEL_NAME=
