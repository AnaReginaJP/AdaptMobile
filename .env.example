# ===============================================
# ADAPTMOBILE ENVIRONMENT CONFIGURATION
# ===============================================
# Copia este archivo a .env y rellena los secretos:  copy .env.example .env

# PostgreSQL Database
POSTGRES_DB=adaptmobile
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password

# Backend JWT Secrets
SECRET_KEY=cambia_esta_clave_secreta
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Initial Admin Credentials
ADMIN_EMAIL=admin@adaptmobile.io
ADMIN_PASSWORD=admin123

# ===============================================
# MOTOR DE IA
# ===============================================
# 'heuristic' -> motor determinista local, sin API key (funciona offline, por defecto)
# 'deepseek'  -> usa la API de DeepSeek si hay key; si no la hay, cae a heurística
AI_PROVIDER=heuristic

# ===============================================
# DEEPSEEK  (la API key va AQUÍ, nunca en docker-compose.yml)
# ===============================================
# Opción A (recomendada para rotarla seguido, SIN reiniciar nada):
#   guarda la key en secrets/deepseek_api_key
#   -> el servicio ai relee ese archivo en CADA petición: la nueva key ya está activa.
# Opción B: ponla en DEEPSEEK_API_KEY y recrea el contenedor:  docker compose up -d ai
# Opción C: en caliente desde Swagger/panel admin:  PUT /api/admin/ai-key
DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY_FILE=/run/secrets/deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT=45
DEEPSEEK_MAX_TOKENS=1200
# Modelo concreto (opcional): si se define, tiene prioridad sobre DEEPSEEK_MODEL
AI_MODEL_NAME=

# Token compartido backend<->ai que autoriza la rotación de la API key.
# Genéralo con:  python -c "import secrets;print(secrets.token_urlsafe(32))"
AI_ADMIN_TOKEN=

# Antigüedad máxima del catálogo: 5 => se descartan los lanzados en 2021 o antes
MAX_AGE_YEARS=5

# ===============================================
# PAGOS (Stripe) — estructura lista, SIN cobros todavía
# ===============================================
# /api/subscriptions/checkout y /api/webhooks/stripe responden 501 por ahora.
# Al activarlos: rellenar estas claves, subscriptions.stripe_price_id y
# descomentar `stripe` en backend/requirements.txt.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FRONTEND_URL=http://localhost:3000

# Proveedores alternativos (no usados por el motor actual)
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- IA local con Ollama (compatible con OpenAI) ---
# AI_PROVIDER=deepseek
# DEEPSEEK_BASE_URL=http://127.0.0.1:11434/v1   # túnel SSH o IP de la VPN hacia Ollama
# DEEPSEEK_MODEL=qwen2.5-coder:7b
